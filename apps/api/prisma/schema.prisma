generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoSourceType {
  YOUTUBE
  TIKTOK
  UPLOAD
}

enum VideoStatus {
  CREATED
  PROCESSING
  COMPLETED
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model Video {
  id           String          @id @default(cuid())
  sourceType   VideoSourceType
  youtubeId    String?         @unique
  sourceUrl    String?
  title        String
  titleHanzi   String?
  level        Int?
  topic        String?
  channel      String?
  durationSec  Float?
  thumbnailUrl String?
  mediaPath    String?
  status       VideoStatus     @default(CREATED)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  segments     Segment[]
  jobs         ProcessingJob[]
}

model Segment {
  id        String   @id @default(cuid())
  videoId   String
  start     Float
  end       Float
  hanzi     String
  pinyin    String
  vi        String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, order])
  @@index([videoId, start])
}

model ProcessingJob {
  id           String    @id @default(cuid())
  videoId      String
  status       JobStatus @default(QUEUED)
  currentStep  String?
  progress     Int       @default(0)
  attempts     Int       @default(0)
  errorCode    String?
  errorMessage String?
  checkpoint   Json?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  video        Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, status])
}
